{
  "name": "dsh-plugin-weixin-lite",
  "version": "0.1.5",
  "description": "Lite WeChat remote control for DeepSeek Harness: bind one WeChat chat to one workspace session.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "qrcode-terminal": "^0.12.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    }
  },
  "bin": {
    "dsh-plugin-weixin-lite": "bin/install.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src",
    "bin",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "FORK.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "login": "node bin/login.js"
  }
}
